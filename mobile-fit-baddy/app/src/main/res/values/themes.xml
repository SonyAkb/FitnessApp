<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FitQuest" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/cream</item>
        <item name="colorPrimaryContainer">@color/moss</item>
        <item name="colorSecondary">@color/fox_orange</item>
        <item name="colorOnSecondary">@color/cream</item>
        <item name="colorSecondaryContainer">#FFD7B3</item>
        <item name="colorTertiary">@color/ember</item>
        <item name="android:statusBarColor">@color/forest_dark</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:windowBackground">@color/moss</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.FitQuest.Button</item>
    </style>

    <style name="Widget.FitQuest.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fox_orange</item>
        <item name="android:textColor">@color/cream</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.FitQuest.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/forest</item>
        <item name="android:textColor">@color/forest_dark</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/leaf_ink</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Card.Quest" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
