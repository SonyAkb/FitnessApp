# Копия для локального запуска: cp .env.example .env
# .env в git не попадает (см. .gitignore) — DEVICE_TOKEN секрет, значение сюда не кладём.

SENSOR_MODE=mock
I2C_BUS=1
MPU6050_ADDR=0x68
MAX30102_ADDR=0x57
MAX30102_INT_PIN=17
GPIOZERO_PIN_FACTORY=mock

# Параметры алгоритмов — стартовые значения для синтетики, подбираются на
# реальном железе (docs/pi.md §3.8, уточняется в PI-10).
SAMPLE_RATE_HZ=50
STEP_THRESHOLD_G=0.15
STEP_SMOOTHING_SAMPLES=3
STEP_MIN_INTERVAL_MS=300
HR_BAND_HZ_LOW=0.5
HR_BAND_HZ_HIGH=4.0
HR_MIN_SIGNAL_RATIO=0.01
HR_WINDOW_S=5

HISTORY_MAX_POINTS=3600
BATTERY_PERCENT=82
SCENARIO=walk

# Публикация в backend-fit-baddy (см. README -> "Отправка данных в backend")
BACKEND_URL=
DEVICE_ID=
DEVICE_TOKEN=
PUBLISH_ENABLED=false
PUBLISH_INTERVAL_SECONDS=5
CALORIES_PER_STEP=0.04
