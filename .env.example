POSTGRES_USER=fitquest
POSTGRES_PASSWORD=fitquest
POSTGRES_DB=fitquest

# Used by the API container (docker compose sets host `db`)
DATABASE_URL=postgresql+psycopg2://fitquest:fitquest@db:5432/fitquest

# Change this for any shared/demo machine
SECRET_KEY=CHANGE_ME_dev_only_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
CORS_ORIGINS=*

# Optional: old React UI
VITE_API_URL=http://localhost:8000
